[Unit]
Description=TUI-OS desktop (tty1)
After=systemd-user-sessions.service systemd-vconsole-setup.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=tui
Environment=TERM=linux HOME=/home/tui
ExecStart=/usr/local/bin/tui-desktop
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=on-failure
RestartSec=1
# Salida normal (Q / Ctrl+Q): dejar una consola de texto en tty1. Si falla, Restart la relanza.
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] && systemctl start --no-block getty@tty1.service || true'

[Install]
WantedBy=multi-user.target
